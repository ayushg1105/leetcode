class Solution(object):
    def minRemoveToMakeValid(self, s):
        """
        :type s: str
        :rtype: str
        """
        s_list = list(s)
        stack = []
        for i,char in enumerate(s_list):
            if char == '(':
                stack.append(i)
            elif char == ')':
                if stack:
                    stack.pop()
                else:
                    s_list[i]=""
        for i in stack:
            s_list[i] = ""
        
        return "".join(s_list)
