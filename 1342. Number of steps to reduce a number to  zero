class Solution(object):
    def numberOfSteps(self, num):
        """
        :type num: int
        :rtype: int
        """
        r=0
        while num != 0:
            if num%2==0:
                num = num/2
                r=r+1
            elif num%2 != 0:
                num = num - 1
                r=r+1
            elif num==1:
                num = num-1
                r=r+1
        return r
