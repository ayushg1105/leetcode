class Solution(object):
    def isValid(self, s):
        """
        :type s: str
        :rtype: bool
        """
        m = {')': '(', '}': '{', ']': '['}
        stack = []
        for char in s:
            if char in m:
                t = stack.pop() if stack else '#'
                if m[char] != t:
                    return False
            else:
                stack.append(char)
        return len(stack)== 0 
