class Solution(object):
    def uniformArray(self, nums1):
        """
        :type nums1: List[int]
        :rtype: bool
        """
        return True
        mn = float('inf')
        for x in nums1:
            if x % 2 == 1:
                mn = min(mn,x)
        
        for x in nums1:
            if x % 2 == 0 and mn != float('inf') and x < mn:
                return False
        return True
