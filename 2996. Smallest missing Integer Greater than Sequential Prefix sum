class Solution(object):
    def missingInteger(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        P= [nums[0]]
        for i in range (1,len(nums)):
            if nums[i] == nums[i-1]+1:
                P.append(nums[i])    
            else:
                 break
        s=sum(P)
        while s in nums:
            s = s+1 
        return s
        


        

