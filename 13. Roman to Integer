class Solution(object):
    def romanToInt(self, s):
        """
        :type s: str
        :rtype: int
        """
        s = s.replace("IV", "IIII")
        s = s.replace("IX", "VIIII")
        s = s.replace("XL", "XXXX")
        s = s.replace("XC", "LXXXX")
        s = s.replace("CD", "CCCC")
        s = s.replace("CM", "DCCCC")
        n = 0
        for i in s:
            if i=='I':
                n= n+1
            elif i=='V':
                n=n+5
            elif i=='X':
                n=n+10
            elif i=='L':
                n=n+50
            elif i=='C':
                n=n+100
            elif i=='D':
                n=n+500
            elif i=='M':
                n=n+1000
            else:
                break
        return n
